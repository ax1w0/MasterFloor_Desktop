<UserControl x:Class="MasterFloor.UI.UC.PartnerCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MasterFloor.UI.UC"
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="500">
    <Border BorderBrush="Gray" Background="{DynamicResource WhiteColor}" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10" >
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Top">
                <TextBlock x:Name="tbPartnerName" FontSize="20"/>
                <TextBlock x:Name="tbDirector"/>
                <TextBlock x:Name="tbPhone"/>
                <TextBlock x:Name="tbRank"/>
            </StackPanel>
            <TextBlock x:Name="tbDiscount" Grid.Column="1" FontSize="20"/>
        </Grid>
    </Border>
</UserControl>
