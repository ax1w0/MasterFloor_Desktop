<Window x:Class="MasterFloor.UI.Views.CreatePartnerWnd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MasterFloor.UI.Views"
         mc:Ignorable="d" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Title="Work with partners" Height="650" Width="400">
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="Partner" FontWeight="Bold" FontSize="28" HorizontalAlignment="Center" Margin="0 10"/>
            <TextBlock Text="Partner Type:"/>
            <ComboBox x:Name="cmbPartnerType" Margin="0 10"/>
            <TextBlock Text="Partner Name:"/>
            <TextBox x:Name="tbxName"/>
            <TextBlock Text="Email:"/>
            <TextBox x:Name="tbxEmail" ToolTip="Format: example@mail.com"/>
            <TextBlock Text="Phone:"/>
            <TextBox x:Name="tbxPhone" ToolTip="Format: 79998887766"/>
            <TextBlock Text="Full Name of Director:"/>
            <TextBox x:Name="tbxFullName"/>
            <TextBlock Text="Legal Address:"/>
            <TextBox x:Name="tbxAddress"/>
            <TextBlock Text="TIN (Taxpayer Identification Number):"/>
            <TextBox x:Name="tbxINN" ToolTip="Format: 1234567890"/>
            <TextBlock Text="Rating (1-10):"/>
            <TextBox x:Name="tbxRank"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnBack" Content="Back" Click="btnBack_Click"/>
                <Button x:Name="btnSave" Content="Save" Click="btnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
