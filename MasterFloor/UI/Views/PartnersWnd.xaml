<Window x:Class="MasterFloor.UI.Views.PartnersWnd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MasterFloor.UI.Views"
        mc:Ignorable="d"
        Title="Partners" Height="560" Width="750" WindowStyle="None"
        Icon="/Resources/icon.ico" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Image Source="/Resources/logo.png" HorizontalAlignment="Left" Margin="10"/>
        <TextBlock Text="Main" HorizontalAlignment="Center" VerticalAlignment="Center" 
               FontSize="28" FontWeight="Bold"/>
        <Button x:Name="ExitButton" Content="Exit" HorizontalAlignment="Right" 
            Click="ExitButton_Click"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Partners" FontSize="28" FontWeight="Bold" HorizontalAlignment="Left" Margin="10" VerticalAlignment="Center"/>
            <Grid Grid.Column="1">
                <TextBlock Margin="5">Search by TIN:</TextBlock>
                <TextBox x:Name="innFilter" Margin="0 20 10 0"/>
            </Grid>
            <Grid Grid.Column="2">
                <TextBlock Margin="5">Search by name:</TextBlock>
                <TextBox x:Name="nameFilter" Margin="0 20 10 0"/>
            </Grid>
        </Grid>
        <Border Grid.Row="2" BorderBrush="Gray" Background="{DynamicResource BackgroundColor}" BorderThickness="1" Margin="10 0"
            Height="320">
            <ScrollViewer>
                <StackPanel x:Name="PartnersStackPanel"/>
            </ScrollViewer>
        </Border>
        <Button x:Name="AddButton" HorizontalAlignment="Left" Grid.Row="3" 
            Content="Add" Click="AddButton_Click"/>
        <Button x:Name="btnGetHistory" HorizontalAlignment="Left" Margin="170 0 0 0" 
            Grid.Row="3" Content="Sales History" Click="btnGetHistory_Click"/>
        <ComboBox x:Name="cmbPartnerID" Grid.Row="3" Width="150" Height="25" 
              HorizontalAlignment="Right" Margin="0 0 170 0"/>
        <Button x:Name="UpdateButton" HorizontalAlignment="Right" Grid.Row="3" 
            Content="Edit" Click="UpdateButton_Click"/>
    </Grid>
</Window>
