<Window x:Class="MasterFloor.UI.Views.RealizationHistoryWnd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MasterFloor.UI.Views"
        mc:Ignorable="d" Title="The history of product sales" ResizeMode="NoResize" 
        WindowStartupLocation="CenterScreen" Height="480" Width="500">
    <Grid>
        <StackPanel Margin="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Sales" FontWeight="Bold" FontSize="28" 
               HorizontalAlignment="Center" Margin="0 10 200 10"/>
                <ComboBox x:Name="cmbPartnerName" Height="25" Width="120" 
              SelectionChanged="cmbPartnerName_SelectionChanged"/>
            </StackPanel>
            <DataGrid x:Name="dgHistorySales" Height="300" AutoGenerateColumns="False" 
          IsReadOnly="True" Background="{DynamicResource BackgroundColor}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product Name" 
                            Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="Quantity" Binding="{Binding Count}" 
                            Width="90"/>
                    <DataGridTextColumn Header="Sale Date" Binding="{Binding Date}" 
                            Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnBack" Content="Back" Click="btnBack_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
